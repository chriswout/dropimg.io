{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dropimg",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "UPLOAD_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "MCP_LIMIT",
      "namespace_id": "1005",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "dropimg-images",
      "preview_bucket_name": "dropimg-images-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dropimg",
      "database_id": "local-dropimg-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "dropimg_events"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "local-oauth-kv-placeholder"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ENVIRONMENT": "development",
    "UGC_SHARE_ADS_ENABLED": "false",
    "LONG_TTL_ENABLED": "false",
    "PRO_50MB_ENABLED": "false",
    "MODERATION_ENABLED": "false",
    "MODERATION_ENFORCE": "false",
    "MODERATION_MODEL": "@cf/moondream/moondream3.1-9B-A2B",
    "AUTH_FROM_EMAIL": "DropIMG <signin@dropimg.io>",
    "BILLING_ENABLED": "false"
  },
  "env": {
    "staging": {
      "name": "dropimg-staging",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "UGC_SHARE_ADS_ENABLED": "false",
        "LONG_TTL_ENABLED": "true",
        "PRO_50MB_ENABLED": "true",
        "MODERATION_ENABLED": "false",
        "MODERATION_ENFORCE": "false",
        "MODERATION_MODEL": "@cf/moondream/moondream3.1-9B-A2B",
        "AUTH_FROM_EMAIL": "DropIMG <signin@dropimg.io>",
        "BILLING_ENABLED": "true",
        "PAYPAL_ENV": "sandbox",
        "PAYPAL_PLAN_MONTHLY": "P-15G50054531033903NKPD7ZI",
        "PAYPAL_PLAN_ANNUAL": "P-7F863114YW191224BNKPD7ZQ"
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["signin@dropimg.io"]
        }
      ],
      "ratelimits": [
        {
          "name": "UPLOAD_LIMIT",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "AUTH_LIMIT",
          "namespace_id": "1003",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "MCP_LIMIT",
          "namespace_id": "1005",
          "simple": {
            "limit": 30,
            "period": 60
          }
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "dropimg-images-staging"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dropimg-staging",
          "database_id": "1e169c73-f6dd-4a90-8633-11071667cb96",
          "migrations_dir": "migrations"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "dropimg_events_staging"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "6b780f76a84641ae81b8e7d0f3082767"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    },
    "production": {
      "name": "dropimg",
      "vars": {
        "ENVIRONMENT": "production",
        "UGC_SHARE_ADS_ENABLED": "false",
        "LONG_TTL_ENABLED": "true",
        "PRO_50MB_ENABLED": "false",
        "MODERATION_ENABLED": "true",
        "MODERATION_ENFORCE": "false",
        "MODERATION_MODEL": "@cf/moondream/moondream3.1-9B-A2B",
        "AUTH_FROM_EMAIL": "DropIMG <signin@dropimg.io>",
        "BILLING_ENABLED": "true",
        "PAYPAL_ENV": "live",
        "PAYPAL_PLAN_MONTHLY": "P-3RL00862KD8203139NKPLFSI",
        "PAYPAL_PLAN_ANNUAL": "P-9RD66268708840634NKPLFSQ"
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["signin@dropimg.io"]
        }
      ],
      "ratelimits": [
        {
          "name": "UPLOAD_LIMIT",
          "namespace_id": "1002",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "AUTH_LIMIT",
          "namespace_id": "1004",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "MCP_LIMIT",
          "namespace_id": "1006",
          "simple": {
            "limit": 30,
            "period": 60
          }
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "routes": [
        {
          "pattern": "dropimg.io",
          "custom_domain": true
        },
        {
          "pattern": "www.dropimg.io",
          "custom_domain": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "dropimg-images"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dropimg",
          "database_id": "0adba959-a9d1-42ee-af0c-e62f96e3e0c1",
          "migrations_dir": "migrations"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "dropimg_events"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "77ec791466984672a0db8b21dc41ec93"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}
