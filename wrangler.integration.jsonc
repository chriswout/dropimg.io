{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dropimg",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./tests/fixtures/assets",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "dropimg-images",
      "preview_bucket_name": "dropimg-images-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dropimg",
      "database_id": "local-dropimg-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "dropimg_events"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "local-oauth-kv-placeholder"
    }
  ],
  "ratelimits": [
    {
      "name": "MCP_LIMIT",
      "namespace_id": "1005",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "AUTH_FROM_EMAIL": "DropIMG <signin@dropimg.io>",
    "MODERATION_ENABLED": "false",
    "MODERATION_ENFORCE": "false"
  }
}
