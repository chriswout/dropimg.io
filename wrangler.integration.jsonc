{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dropimg",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./tests/fixtures/assets",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "dropimg-images",
      "preview_bucket_name": "dropimg-images-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dropimg",
      "database_id": "local-dropimg-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "dropimg_events"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["signin@dropimg.io"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "AUTH_FROM_EMAIL": "DropIMG <signin@dropimg.io>"
  }
}
