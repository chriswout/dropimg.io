# Copy to .dev.vars for local development
IP_HASH_SECRET=dev-ip-hash-secret-change-me
ADMIN_TOKEN=dev-admin-token-change-me
# Local dev builds V2, so it runs the lifecycle gates staging has on.
# Production keeps them off in wrangler.jsonc until the launch phase.
LONG_TTL_ENABLED=true
PRO_50MB_ENABLED=true
# Optional: IndexNow key for notifying Bing when marketing pages change
# INDEXNOW_KEY=
# Magic-link mail uses the EMAIL binding (signin@dropimg.io). Local wrangler
# simulates send unless the binding has remote: true.
# PayPal REST. Never commit real secrets. sandbox and live are told apart by
# PAYPAL_ENV, which also picks the API host.
# BILLING_ENABLED=false
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_PLAN_MONTHLY=P-...
# PAYPAL_PLAN_ANNUAL=P-...
# Production webhooks use PAYPAL_WEBHOOK_ID + verify-webhook-signature.
# PAYPAL_WEBHOOK_ID=
# Local/integration tests may set PAYPAL_WEBHOOK_SECRET instead (HMAC).
# PAYPAL_WEBHOOK_SECRET=
